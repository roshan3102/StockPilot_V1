# Copy to `.env` (backend) and fill in real values. NEVER commit `.env`.
# This file lists variable NAMES and safe defaults only.

# --- Backend ---
APP_ENV=dev
DATABASE_URL=sqlite:///./stockpilot.db
FRONTEND_ORIGIN=http://localhost:3000

# --- LLM (OpenAI) ---
OPENAI_API_KEY=
# Model name is configuration, not code. Verify it exists on your account at milestone M5.
LLM_MODEL=gpt-6-luna
# Seconds to wait for each request to the provider before giving up.
LLM_TIMEOUT_SECONDS=30
# gpt-6-luna only supports function tools on Chat Completions with reasoning off. Leave empty
# to omit the parameter entirely (for models that do not accept it).
LLM_REASONING_EFFORT=none

# --- PayPal Sandbox (REST app credentials; see developer.paypal.com) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# --- Frontend (put these in frontend/.env.local) ---
# Anything prefixed NEXT_PUBLIC_ is visible in the browser. Client ID is public; the secret never goes here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
